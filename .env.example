# Archivo de ejemplo para variables de entorno
# Copia este archivo como .env y configura los valores necesarios

# ========================================
# CONFIGURACIÓN GENERAL DEL AGENTE
# ========================================

# Nivel de debug (True/False)
AGENT_DEBUG=True

# Nivel de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
AGENT_LOG_LEVEL=INFO

# Puerto para el agente (si aplica)
AGENT_PORT=8000

# Directorio de logs
LOG_DIR=logs

# ========================================
# CONFIGURACIÓN DE APIs EXTERNAS
# ========================================

# API Key para servicios externos
API_KEY=your_api_key_here

# URL base de la API
API_URL=https://api.ejemplo.com

# Timeout para requests en segundos
API_TIMEOUT=30

# ========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ========================================

# URL de conexión a la base de datos
DATABASE_URL=sqlite:///agent.db

# Pool de conexiones (si aplica)
DB_POOL_SIZE=5

# ========================================
# CONFIGURACIÓN DE OPENAI (si aplica)
# ========================================

# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-3.5-turbo
# OPENAI_MAX_TOKENS=1000

# ========================================
# CONFIGURACIÓN DE OTROS SERVICIOS
# ========================================

# Redis URL (si aplica)
# REDIS_URL=redis://localhost:6379

# Email configuration (si aplica)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password

# ========================================
# CONFIGURACIÓN DEL ENTORNO
# ========================================

# Entorno de ejecución (development, production, testing)
ENVIRONMENT=development

# Secret key para encriptación
SECRET_KEY=your_secret_key_here_change_in_production